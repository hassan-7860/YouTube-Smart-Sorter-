{
  "manifest_version": 3,
  "name": "YouTube Smart Sorter - Stable",
  "version": "9.0",
  "description": "Filters suggestions, stabilizes picks, and refined UI.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/results*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}